    "seed": "tsx src/seed-cli.ts",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@foqus/core": "workspace:*",
    "@neondatabase/serverless": "^1.0.2",
    "drizzle-orm": "^0.44.7"
  },
  "devDependencies": {
    "dotenv": "^17.2.5",
    "drizzle-kit": "^0.31.6",
    "tsx": "^4.20.7",
    "@types/node": "^22.10.5"
  }
