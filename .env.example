# FOQUS — environment variables
#
# Salin file ini menjadi `.env` untuk pengembangan lokal, dan daftarkan setiap variabel di
# Vercel Project Settings → Environment Variables untuk produksi.
# Tidak satu pun nilai di file ini boleh sampai ke browser (BRIEF §15).

# --- Basis data -------------------------------------------------------------------------
# Neon (atau Vercel Postgres). Pakai connection string POOLED — driver HTTP serverless
# membuka koneksi baru tiap query, dan Vercel tidak menjamin instance function yang sama.
# SQLite/better-sqlite3 tidak boleh dipakai: filesystem Vercel bersifat ephemeral.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/foqus?sslmode=require

# --- Google OAuth + Calendar ------------------------------------------------------------
# Dari Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SATU redirect URI tetap di domain produksi. Google menolak URI yang tidak terdaftar, dan
# setiap preview deployment Vercel punya URL berbeda — jangan mendaftarkan URL preview
# satu per satu, pakai domain produksi (atau alias domain preview tetap). Lihat README.
GOOGLE_REDIRECT_URI=https://foqus.example.com/api/auth/google/callback

# --- Rahasia aplikasi --------------------------------------------------------------------
# Penanda tangan JWT session cookie FOQUS.  Buat dengan: openssl rand -base64 48
SESSION_SECRET=

# Kunci AES-GCM untuk mengenkripsi refresh token Google. WAJIB 32 byte dalam base64.
# Buat dengan: openssl rand -base64 32
# Mengganti kunci ini membuat semua refresh token tersimpan tidak bisa dibaca — pengguna
# harus menghubungkan ulang akun Google-nya.
TOKEN_ENC_KEY=

# Melindungi /api/cron/*. Endpoint itu publik kalau tidak dijaga.
# Buat dengan: openssl rand -base64 32
# Tidak ada Vercel Cron di v1 (BRIEF §12) — variabel ini disiapkan agar penjadwal eksternal
# bisa dipasang belakangan tanpa perubahan kode.
CRON_SECRET=

# --- Aplikasi ----------------------------------------------------------------------------
# Basis URL publik. Dipakai untuk redirect setelah OAuth. Lokal: http://localhost:3000
APP_URL=https://foqus.example.com
